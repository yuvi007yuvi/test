rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Face images folder
    match /face_images/{imageId} {
      // Allow users to read their own face images
      allow read: if request.auth != null && 
        request.auth.uid == imageId.replace('.jpg', '');
      
      // Allow users to create their own face images
      allow create: if request.auth != null && 
        request.auth.uid == imageId.replace('.jpg', '');
      
      // Allow users to update their own face images
      allow update: if request.auth != null && 
        request.auth.uid == imageId.replace('.jpg', '');
      
      // For development, allow admins to read any face images
      // In production, restrict this to admins only
      allow read: if request.auth != null;
    }
    
    // Profile images folder
    match /profile_images/{imageId} {
      // Allow users to read their own profile images
      allow read: if request.auth != null && 
        request.auth.uid == imageId.replace('.jpg', '');
      
      // Allow users to create their own profile images
      allow create: if request.auth != null && 
        request.auth.uid == imageId.replace('.jpg', '');
      
      // Allow users to update their own profile images
      allow update: if request.auth != null && 
        request.auth.uid == imageId.replace('.jpg', '');
    }
    
    // Allow authenticated users to read any images (for development)
    // In production, restrict this to admins only
    match /{allPaths=**} {
      allow read: if request.auth != null;
    }
  }
}